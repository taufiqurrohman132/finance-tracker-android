<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
       Ukuran + 🎨 Warna Teks Fintech
    🔹 Heading / Title
    Ukuran: 20sp – 22sp
    Warna: Hitam pekat (#000000) atau Dark Gray (#212121 / #1C1C1C)
    🔹 Section Title / Judul Halaman / Kategori
    Ukuran: 18sp – 20sp
    Warna: Hitam pekat (#000000)
    🔹 Card / List Title
    Ukuran: 16sp – 18sp
    Warna: Hitam pekat (#212121)
    🔹 Body utama (deskripsi / teks isi)
    Ukuran: 14sp – 16sp
    Warna: Abu-abu gelap (#333333 / #424242)
    🔹 Secondary text / Keterangan tambahan
    Ukuran: 12sp – 14sp
    Warna: Abu-abu medium (#666666 / #757575)
    🔹 Data angka penting (Saldo utama, angka besar)
    Ukuran: 22sp – 28sp (tebal / bold)
    Warna:
    Default → Hitam pekat (#000000)
    Bisa pakai warna brand → contoh: Biru DANA (#108EE9), Hijau OVO (#00A859)
    🔹 Nominal transaksi dalam list
    Ukuran: 16sp – 18sp
    Warna:
    Hijau (#2E7D32 / #4CAF50) → untuk pemasukan
    Merah (#C62828 / #E53935) → untuk pengeluaran
    Style: Medium / Semi-bold
    🔹 Detail kecil (tanggal, catatan transaksi)
    Ukuran: 12sp – 14sp
    Warna: Abu-abu terang (#9E9E9E / #B0B0B0)
    🔹 Button text (CTA, contoh: "Transfer", "Bayar")
    Ukuran: 14sp – 16sp (Bold)
    Warna: Putih (#FFFFFF) di atas background brand
    🔹 Secondary button / Link kecil
    Ukuran: 12sp – 14sp
    Warna: Warna brand (misal biru, hijau, ungu)
    🔹 Form (label & input text)
    Label
    Ukuran: 12sp – 14sp
    Warna: Abu-abu medium (#757575)
    Input text (yang diketik user)
    Ukuran: 14sp – 16sp
    Warna: Hitam pekat (#212121)
    Hint text (placeholder)
    Ukuran: 12sp – 14sp
    Warna: Abu-abu terang (#9E9E9E)-->
